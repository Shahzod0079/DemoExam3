<Page x:Class="DemoExam3.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Background="White">
        <Grid Background="Green" VerticalAlignment="Top" Height="70">
            <Label Content="Мебельная продукция" VerticalAlignment="Center" 
                   Foreground="White" FontSize="20" FontWeight="Bold"  Margin="10"/>

            <Button Click="Add" Content="Добавить" Width="100" 
                    HorizontalAlignment="Right" Margin="10" />
        </Grid>

        <ScrollViewer Margin="0,80,0,10" >
                <StackPanel x:Name="spItems" />
            </ScrollViewer>

    </Grid>
</Page>
